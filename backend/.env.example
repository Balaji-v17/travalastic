PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_here
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
DUFFEL_API_KEY=your_duffel_api_key
BOOKING_AFFILIATE_ID=your_booking_affiliate_id
PEXELS_API_KEY=your_pexels_api_key_here
WEB_ORIGINS=http://localhost:8443,http://localhost:5173

# Duffel Webhooks
# HMAC-SHA256 secret provided once upon registering webhook with Duffel
DUFFEL_WEBHOOK_SECRET=your_duffel_webhook_secret_here
# Maximum age of webhook timestamp in seconds; 0 disables tolerance check (default: 0)
DUFFEL_WEBHOOK_TOLERANCE_SECONDS=0

# Disruption Simulator
# Enables POST /disruptions/simulate endpoint for demos and manual testing (default: false)
ENABLE_DISRUPTION_SIMULATOR=false
