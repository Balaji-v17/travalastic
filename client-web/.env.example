VITE_API_BASE_URL=http://localhost:8000

# Demo-only flight delay simulator (keep false in production)
VITE_ENABLE_SIMULATOR=false

# Toggle sample/mock pages (default false)
VITE_SHOW_SAMPLE_PAGES=false

# Shows "Test fares" banner for sandbox airline connection (default true; set 'false' in production)
VITE_FLIGHTS_TEST_MODE=true

# Optional Uber Client ID for universal links (defaults to empty; mobile app leaves unset)
VITE_UBER_CLIENT_ID=
